{
  "expo": {
    "name": "Mana",
    "slug": "mana-recipes",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "mana",
    "newArchEnabled": true,
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yaronogen.mana",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "de",
          "he"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yaronogen.mana",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1C412B"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mana uses your photo library so you can add a picture of your dish to a recipe.",
          "cameraPermission": "Mana uses the camera so you can take a picture of the dish you made."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1C412B",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
